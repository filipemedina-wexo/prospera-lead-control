# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# mock: laboratório local com dados simulados | live: autenticação e dados reais
# Em produção, use sempre "live".
VITE_APP_MODE=mock

# Somente em funções de servidor (webhook, convites e e-mails). Nunca expor no Vite.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
